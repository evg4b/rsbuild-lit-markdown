{
  "name": "rsbuild-lit-markdown",
  "version": "1.1.0",
  "repository": "https://github.com/evg4b/rsbuild-lit-markdown",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "biome check .",
    "lint:write": "biome check . --write",
    "prepare": "simple-git-hooks && yarn run build",
    "test": "playwright test",
    "bump": "npx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn run lint:write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@rsbuild/core": "~2.2.12",
    "@rslib/core": "~1.0.3",
    "@types/node": "^26.6.4",
    "lit": "~3.3.3",
    "marked": "~18.1.0",
    "marked-gfm-heading-id": "~4.1.4",
    "playwright": "^1.64.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=1 <2",
    "lit": ">=3 <4",
    "marked": ">=17 <19",
    "marked-gfm-heading-id": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
